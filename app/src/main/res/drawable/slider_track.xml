<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="@dimen/slider_track">
        <shape android:shape="rectangle">
            <solid android:color="@color/slider_inactive" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="@dimen/slider_track">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/accent" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
</layer-list>
