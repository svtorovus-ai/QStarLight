<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#142834" android:endColor="#101A2D" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#39D6E5" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#0B1118" android:endColor="#04070B" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#182733" />
        </shape>
    </item>
</selector>
