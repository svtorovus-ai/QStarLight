<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/tab_selector_selected_start" android:endColor="@color/tab_selector_selected_end" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="@color/tab_selector_selected_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/tab_selector_start" android:endColor="@color/tab_selector_end" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="@color/tab_selector_stroke" />
        </shape>
    </item>
</selector>
