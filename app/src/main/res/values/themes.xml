<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QStarLight" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:navigationBarColor">#010205</item>
        <item name="android:statusBarColor">#010205</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.QStarLight.Translucent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
