<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@drawable/bg_header_glow"
        android:elevation="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QSTAR LIGHT"
                android:textColor="@color/text"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v0.3.0"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="ТЕЛЕФОН • REMOTE"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/controlPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_panel"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:padding="15dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvLinkStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="− Магнітола • немає з’єднання"
                            android:textColor="@color/text"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <Button
                            android:id="@+id/btnReconnect"
                            android:layout_width="112dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_button_outline"
                            android:text="Підключити"
                            android:textAllCaps="false"
                            android:textColor="@color/text" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvLamp1"
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_soft"
                            android:gravity="center_vertical"
                            android:padding="11dp"
                            android:text="Ліва фара • QStar~F072\nнемає з’єднання"
                            android:textColor="@color/text"
                            android:textSize="12sp" />
                        <Space android:layout_width="9dp" android:layout_height="1dp" />
                        <TextView
                            android:id="@+id/tvLamp2"
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_soft"
                            android:gravity="center_vertical"
                            android:padding="11dp"
                            android:text="Права фара • QStar~D35D\nнемає з’єднання"
                            android:textColor="@color/text"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/routeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_card"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="13dp">
                    <TextView
                        android:id="@+id/tvRoute"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Основний канал: телефон → магнітола → лампи"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/btnRouteHub"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_segment_selector"
                            android:text="Через магнітолу"
                            android:textAllCaps="false"
                            android:textColor="@color/text" />
                        <Space android:layout_width="8dp" android:layout_height="1dp" />
                        <Button
                            android:id="@+id/btnRouteDirect"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_segment_selector"
                            android:text="Прямий BLE"
                            android:textAllCaps="false"
                            android:textColor="@color/text" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_card"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <Switch
                        android:id="@+id/switchPower"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Фари"
                        android:textColor="@color/text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ШВИДКИЙ КОЛІР"
                        android:textColor="@color/muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="7dp"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/btnYellow"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_preset_yellow"
                            android:text="ЖОВТИЙ"
                            android:textColor="@color/preset_yellow_text"
                            android:textStyle="bold" />
                        <Space android:layout_width="9dp" android:layout_height="1dp" />
                        <Button
                            android:id="@+id/btnWarm"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_preset_warm"
                            android:text="ТЕПЛИЙ"
                            android:textColor="@color/preset_warm_text"
                            android:textStyle="bold" />
                        <Space android:layout_width="9dp" android:layout_height="1dp" />
                        <Button
                            android:id="@+id/btnWhite"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_preset_white"
                            android:text="БІЛИЙ"
                            android:textColor="@color/preset_white_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTemp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Колір • Білий 100%   Жовтий 0%"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                    <SeekBar
                        android:id="@+id/seekTemp"
                        android:layout_width="match_parent"
                        android:layout_height="42dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvBrightness"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Яскравість • 100%"
                            android:textColor="@color/text"
                            android:textSize="13sp" />
                        <Button
                            android:id="@+id/btnBrightnessDown"
                            android:layout_width="48dp"
                            android:layout_height="42dp"
                            android:text="−"
                            android:textSize="20sp" />
                        <Button
                            android:id="@+id/btnBrightnessUp"
                            android:layout_width="48dp"
                            android:layout_height="42dp"
                            android:text="+"
                            android:textSize="20sp" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekBrightness"
                        android:layout_width="match_parent"
                        android:layout_height="42dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_card"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="15dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚡ СТРОБОСКОП"
                                android:textColor="@color/accent"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvStrobeMode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Класичний • Білий • 100%"
                                android:textColor="@color/muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                        <Button
                            android:id="@+id/btnStrobeToggle"
                            android:layout_width="132dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_button_accent"
                            android:text="СТРОБ"
                            android:textColor="@color/button_accent_text"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Режим, швидкість, колір і чергування лівої/правої лампи задаються в налаштуваннях."
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="15dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="РОЛЬ ЦЬОГО ПРИСТРОЮ" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <Button android:id="@+id/btnRoleHub" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_segment_selector" android:text="Магнітола • HUB" android:textAllCaps="false" android:textColor="@color/text" />
                        <Space android:layout_width="8dp" android:layout_height="1dp" />
                        <Button android:id="@+id/btnRolePhone" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_segment_selector" android:text="Телефон • Remote" android:textAllCaps="false" android:textColor="@color/text" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hubPinGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_card"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="15dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ПІДКЛЮЧЕННЯ ТЕЛЕФОНА" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvHubPin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="123456" android:textColor="@color/accent" android:textSize="31sp" android:textStyle="bold" android:letterSpacing="0.12" />
                    <Button android:id="@+id/btnNewPin" android:layout_width="match_parent" android:layout_height="46dp" android:background="@drawable/bg_button_outline" android:text="Новий PIN" android:textAllCaps="false" android:textColor="@color/text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/phonePairGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_card"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="15dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="МАГНІТОЛА" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvRemoteStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Магнітола: пошук / offline" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold" />
                    <EditText android:id="@+id/editRemotePin" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="9dp" android:background="@drawable/bg_input" android:hint="PIN з магнітоли" android:inputType="number" android:maxLength="6" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/text" android:textColorHint="@color/muted" />
                    <EditText android:id="@+id/editHubIp" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input" android:hint="IP магнітоли (необов'язково)" android:inputType="text" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/text" android:textColorHint="@color/muted" />
                    <Button android:id="@+id/btnSavePair" android:layout_width="match_parent" android:layout_height="49dp" android:layout_marginTop="9dp" android:background="@drawable/bg_button_accent" android:text="Знайти та підключити" android:textAllCaps="false" android:textColor="@color/button_accent_text" android:textStyle="bold" />
                    <Switch android:id="@+id/switchForceDirect" android:layout_width="match_parent" android:layout_height="48dp" android:text="Прямий BLE зараз" android:textColor="@color/text" />
                    <Switch android:id="@+id/switchDirectFallback" android:layout_width="match_parent" android:layout_height="48dp" android:text="Резервний BLE, якщо HUB недоступний" android:textColor="@color/text" />
                    <Switch android:id="@+id/switchRemoteKeepAlive" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone" android:text="Тримати зв'язок з HUB у фоні" android:textColor="@color/text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_card"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="15dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="СИНХРОНІЗАЦІЯ ТА ОНОВЛЕННЯ" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvSyncStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Налаштування синхронізуються автоматично" android:textColor="@color/text" android:textSize="13sp" />
                    <Button android:id="@+id/btnSyncNow" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="7dp" android:background="@drawable/bg_button_outline" android:text="Синхронізувати зараз" android:textAllCaps="false" android:textColor="@color/text" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Спільні: колір, яскравість, профілі старту й строба та вибрані лампи. Роль, PIN, автозапуск і параметри зв’язку задаються окремо на кожному пристрої." android:textColor="@color/muted" android:textSize="11sp" />
                    <Button android:id="@+id/btnCheckUpdate" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="7dp" android:background="@drawable/bg_button_outline" android:text="Перевірити оновлення додатка зараз" android:textAllCaps="false" android:textColor="@color/text" />
                    <TextView android:id="@+id/tvUpdateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Версія HUB: невідомо" android:textColor="@color/muted" android:textSize="12sp" />
                    <Switch android:id="@+id/switchAutoPushUpdates" android:layout_width="match_parent" android:layout_height="48dp" android:text="Автоматично передавати нову версію з телефона на HUB" android:textColor="@color/text" />
                    <Switch android:id="@+id/switchSilentRootInstall" android:layout_width="match_parent" android:layout_height="48dp" android:text="Тихе встановлення через root, якщо доступний" android:textColor="@color/text" />
                    <Button android:id="@+id/btnPushUpdate" android:layout_width="match_parent" android:layout_height="49dp" android:layout_marginTop="7dp" android:background="@drawable/bg_button_accent" android:text="Оновити магнітолу з цього телефона" android:textAllCaps="false" android:textColor="@color/button_accent_text" android:textStyle="bold" />
                    <Button android:id="@+id/btnInstallPermission" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="7dp" android:background="@drawable/bg_button_outline" android:text="Дозволити встановлення оновлень на цьому HUB" android:textAllCaps="false" android:textColor="@color/text" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Без root Android може показати системне підтвердження встановлення. APK копіювати вручну більше не треба." android:textColor="@color/muted" android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_card"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="15dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="СТАРТ ФАР" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
                    <Switch android:id="@+id/switchAutoBoot" android:layout_width="match_parent" android:layout_height="48dp" android:text="Автозапуск HUB після завантаження" android:textColor="@color/text" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Режим старту" android:textColor="@color/text" android:textSize="12sp" />
                    <Spinner android:id="@+id/spinnerStartupMode" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:paddingStart="10dp" android:paddingEnd="10dp" />
                    <TextView android:id="@+id/tvStartWhite" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Стартовий колір • Жовтий" android:textColor="@color/text" android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekStartWhite" android:layout_width="match_parent" android:layout_height="40dp" />
                    <TextView android:id="@+id/tvTargetWhite" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Колір після переходу • Білий" android:textColor="@color/text" android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekTargetWhite" android:layout_width="match_parent" android:layout_height="40dp" />
                    <TextView android:id="@+id/tvStartBrightness" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Стартова яскравість • 100%" android:textColor="@color/text" android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekStartBrightness" android:layout_width="match_parent" android:layout_height="40dp" />
                    <TextView android:id="@+id/tvFadeDuration" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Тривалість переходу • 1.8 с" android:textColor="@color/text" android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekFadeDuration" android:layout_width="match_parent" android:layout_height="40dp" />
                    <TextView android:id="@+id/tvFadeSteps" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Плавність • 24 кроки" android:textColor="@color/text" android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekFadeSteps" android:layout_width="match_parent" android:layout_height="40dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_card"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="15dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚡ МИГАЛКИ / СТРОБ" android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Режим" android:textColor="@color/text" android:textSize="12sp" />
                    <Spinner android:id="@+id/spinnerStrobeMode" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:paddingStart="10dp" android:paddingEnd="10dp" />
                    <TextView android:id="@+id/tvStrobeWhite" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Колір строба • Білий" android:textColor="@color/text" android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekStrobeWhite" android:layout_width="match_parent" android:layout_height="40dp" />
                    <TextView android:id="@+id/tvStrobeBrightness" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Яскравість строба • 100%" android:textColor="@color/text" android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekStrobeBrightness" android:layout_width="match_parent" android:layout_height="40dp" />
                    <TextView android:id="@+id/tvStrobeOn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Імпульс • 120 мс" android:textColor="@color/text" android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekStrobeOn" android:layout_width="match_parent" android:layout_height="40dp" />
                    <TextView android:id="@+id/tvStrobeOff" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Проміжок • 110 мс" android:textColor="@color/text" android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekStrobeOff" android:layout_width="match_parent" android:layout_height="40dp" />
                    <TextView android:id="@+id/tvStrobePause" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Пауза між серіями • 420 мс" android:textColor="@color/text" android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekStrobePause" android:layout_width="match_parent" android:layout_height="40dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Строб реалізований командами BLE, без невідомих режимів прошивки контролера." android:textColor="@color/muted" android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_card"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="15dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ЛАМПИ QSTAR" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <Button android:id="@+id/btnScan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Скан" android:textAllCaps="false" />
                        <Button android:id="@+id/btnSelect" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Вибрати" android:textAllCaps="false" />
                        <Button android:id="@+id/btnPasswords" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Паролі" android:textAllCaps="false" />
                    </LinearLayout>
                    <Switch android:id="@+id/switchKeep" android:layout_width="match_parent" android:layout_height="48dp" android:text="Тримати BLE підключеним" android:textColor="@color/text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_card"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="15dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ШВИДКЕ КЕРУВАННЯ" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Віджет: Жовтий • Теплий • Білий • ⚡ • шкала яскравості.\nAndroid 11+: QStar Light можна додати до системної панелі «Пристрої»." android:textColor="@color/text" android:textSize="12sp" />
                </LinearLayout>


            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/diagnosticsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="15dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ДІАГНОСТИКА" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvDiagnosticsInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text" android:textSize="12sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="9dp" android:orientation="horizontal">
                        <Button android:id="@+id/btnCopyLogs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_button_outline" android:text="Копіювати" android:textAllCaps="false" android:textColor="@color/text" />
                        <Space android:layout_width="8dp" android:layout_height="1dp" />
                        <Button android:id="@+id/btnExportLogs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_button_accent" android:text="Експорт .txt" android:textAllCaps="false" android:textColor="@color/button_accent_text" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvLogCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/muted" android:textSize="11sp" />
                    <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:minHeight="120dp" android:textColor="@color/log_text" android:textIsSelectable="true" android:textSize="10sp" android:typeface="monospace" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="9dp"
        android:orientation="horizontal"
        android:padding="7dp">
        <Button
            android:id="@+id/tabControl"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selector"
            android:text="Світло"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="12sp" android:paddingStart="2dp" android:paddingEnd="2dp" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <Button
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selector"
            android:text="Налаштування"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="12sp" android:paddingStart="2dp" android:paddingEnd="2dp" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <Button android:id="@+id/tabDiagnostics" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_tab_selector" android:text="Діагностика" android:textAllCaps="false" android:textColor="@color/text" android:textSize="12sp" android:paddingStart="2dp" android:paddingEnd="2dp" />
    </LinearLayout>
</LinearLayout>
