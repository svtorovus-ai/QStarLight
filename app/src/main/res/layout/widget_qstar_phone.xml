<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widgetTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08" android:text="QSTAR LIGHT" android:textColor="#F7F9FC" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/widgetStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_status_pill" android:paddingStart="9dp" android:paddingTop="4dp" android:paddingEnd="9dp" android:paddingBottom="4dp" android:text="Білий • 100%" android:textColor="#72EAF3" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal" android:minHeight="84dp" android:baselineAligned="false">
        <TextView android:id="@+id/widgetLeftLink" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="−\nЛІВА" android:textColor="#FF4F5E" android:textSize="12sp" android:textStyle="bold" android:minHeight="84dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/widget_status_pill" />
        <TextView android:id="@+id/widgetHubLink" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="−\nМАФОН" android:textColor="#FF4F5E" android:textSize="12sp" android:textStyle="bold" android:minHeight="84dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/widget_status_pill" />
        <TextView android:id="@+id/widgetRightLink" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="−\nПРАВА" android:textColor="#FF4F5E" android:textSize="12sp" android:textStyle="bold" android:minHeight="84dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/widget_status_pill" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal" android:minHeight="46dp" android:baselineAligned="false">
        <Button android:id="@+id/widgetYellow" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_button_gold" android:minWidth="0dp" android:minHeight="46dp" android:text="ЖОВТИЙ" android:textColor="#FFD76A" android:textSize="10sp" android:textStyle="bold" android:paddingStart="2dp" android:paddingEnd="2dp" />
        <Button android:id="@+id/widgetWarm" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:layout_weight="1" android:background="@drawable/widget_button_warm" android:minWidth="0dp" android:minHeight="46dp" android:text="ТЕПЛИЙ" android:textColor="#FFE2A8" android:textSize="10sp" android:textStyle="bold" android:paddingStart="2dp" android:paddingEnd="2dp" />
        <Button android:id="@+id/widgetWhite" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_button_white" android:minWidth="0dp" android:minHeight="46dp" android:text="БІЛИЙ" android:textColor="#F4F9FC" android:textSize="10sp" android:textStyle="bold" android:paddingStart="2dp" android:paddingEnd="2dp" />
        <Button android:id="@+id/widgetStrobe" android:layout_width="42dp" android:layout_height="match_parent" android:layout_marginStart="2dp" android:background="@drawable/widget_button_dark" android:minWidth="0dp" android:minHeight="46dp" android:text="⚡" android:textColor="#63E6F0" android:textSize="17sp" android:textStyle="bold" android:paddingStart="2dp" android:paddingEnd="2dp" android:contentDescription="Мигалки" />
    </LinearLayout>
    <TextView android:id="@+id/widgetBrightnessLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:letterSpacing="0.05" android:text="ЯСКРАВІСТЬ" android:textColor="#7F8B9C" android:textSize="10sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/b10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▬" android:textSize="18sp" android:contentDescription="Яскравість 10%" />
        <TextView android:id="@+id/b20" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▬" android:textSize="18sp" android:contentDescription="Яскравість 20%" />
        <TextView android:id="@+id/b30" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▬" android:textSize="18sp" android:contentDescription="Яскравість 30%" />
        <TextView android:id="@+id/b40" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▬" android:textSize="18sp" android:contentDescription="Яскравість 40%" />
        <TextView android:id="@+id/b50" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▬" android:textSize="18sp" android:contentDescription="Яскравість 50%" />
        <TextView android:id="@+id/b60" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▬" android:textSize="18sp" android:contentDescription="Яскравість 60%" />
        <TextView android:id="@+id/b70" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▬" android:textSize="18sp" android:contentDescription="Яскравість 70%" />
        <TextView android:id="@+id/b80" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▬" android:textSize="18sp" android:contentDescription="Яскравість 80%" />
        <TextView android:id="@+id/b90" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▬" android:textSize="18sp" android:contentDescription="Яскравість 90%" />
        <TextView android:id="@+id/b100" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▬" android:textSize="18sp" android:contentDescription="Яскравість 100%" />
    </LinearLayout>
</LinearLayout>
